# Copy to .env and edit. Every value here is read by adaptive_agent/config.py.

# --- Neo4j ---------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=please-change-me
NEO4J_DATABASE=neo4j

# --- Chat LLM: any OpenAI-compatible endpoint ----------------------------
# Default: local Ollama. For OpenAI, set LLM_BASE_URL=https://api.openai.com/v1
# and a real key/model.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:4b

# --- Embeddings (runs locally, downloads once from Hugging Face) ---------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Fine-tuning base model ----------------------------------------------
BASE_MODEL_ID=Qwen/Qwen3-0.6B
